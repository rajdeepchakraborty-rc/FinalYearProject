# ============================================================
# SignalStream — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ─── General ─────────────────────────────────────────────────
APP_NAME=signalstream
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-64-char-string

# ─── API Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=1000
API_MAX_REQUEST_SIZE_MB=10

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://signalstream:signalstream@localhost:5432/signalstream
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# ─── Kafka ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_COMPRESSION_TYPE=lz4

# ─── MinIO / S3 ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=signalstream
S3_REGION=us-east-1

# ─── Inference Server ───────────────────────────────────────
INFERENCE_SERVER_URL=http://localhost:8100
INFERENCE_TIMEOUT_SECONDS=30

# ─── MCP Server ─────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8200
MCP_TIMEOUT_SECONDS=5

# ─── LLM Provider ───────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=60

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# Local (vLLM/Ollama)
LOCAL_LLM_URL=http://localhost:8300
LOCAL_LLM_MODEL=llama3

# ─── LLM Cost Control ───────────────────────────────────────
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_CACHE_TTL_SECONDS=1800
LLM_SEMANTIC_CACHE_THRESHOLD=0.95

# ─── Monitoring ──────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── PII Detection ──────────────────────────────────────────
PII_DETECTION_ENABLED=true
PII_REDACTION_ENABLED=true

# ─── Auto Resolver ──────────────────────────────────────────
AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.95
DRAFT_RESPONSE_CONFIDENCE_THRESHOLD=0.75
HIGH_RISK_CATEGORIES=fraud,legal,security,safety,regulatory

# ─── Data Retention (days) ──────────────────────────────────
RETENTION_RAW_EVENTS_DAYS=90
RETENTION_ANALYTICS_DAYS=1095
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_EMBEDDINGS_DAYS=365
